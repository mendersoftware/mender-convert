{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":rebaseStalePrs"
  ],

  // CODEOWNERS drives reviewer assignment. Keep CODEOWNERS complete.
  "reviewersFromCodeOwners": true,

  // chore(deps): <desc>, matching the old Dependabot prefix. CI files get ci: below.
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",

  // Drain backlogs gradually. 10 concurrent because there are three base branches.
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,

  "baseBranchPatterns": ["master"],

  // Security PRs bypass the schedule
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },

  "packageRules": [
    // GitLab CI image bumps -> ci: (keeps them out of the deps changelog section).
    {
      "matchManagers": ["gitlabci", "gitlabci-include"],
      "semanticCommitType": "ci",
      "semanticCommitScope": ""
    },

    // Docker base images: one grouped PR.
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker-base-images",
      "groupSlug": "docker-base-images"
    },

    // QA-1780: debian:12 is pinned on purpose to get qemu-user 7.2. Newer
    // Debian ships qemu 8.2+ which breaks apt in arm64 chroots, and the
    // Dockerfile version check fails the build. Re-enable once fixed upstream.
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["Dockerfile"],
      "matchDepNames": ["debian"],
      "matchCurrentValue": "12",
      "enabled": false
    },
  ],

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.gitlab-ci.yml/"],
      "matchStrings": [
        "MENDER_ARTIFACT_VERSION:[\\s\\S]*?value:\\s*[\"']?(?<currentValue>[\\d\\.]+)[\"']?"
      ],
      "depNameTemplate": "mendersoftware/mender-artifact",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "versioningTemplate": "semver"
    },
  ],
}
